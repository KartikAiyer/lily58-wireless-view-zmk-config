#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <12 13>;
        };

        combo_escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        macro_next_tab: macro_next_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(TAB)>, <&macro_press>;

            label = "MACRO_NEXT_TAB";
        };

        macro_prev_tab: macro_prev_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LS(TAB))>, <&macro_press>;

            label = "MACRO_PREV_TAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp EQUAL       &kp N1  &kp N2  &kp N3          &kp N4        &kp N5                                       &kp N6       &kp N7         &kp N8     &kp N9   &kp N0    &kp MINUS
&kp GRAVE       &kp Q   &kp W   &kp E           &kp R         &kp T                                        &kp Y        &kp U          &kp I      &kp O    &kp P     &kp BACKSLASH
&kp LEFT_SHIFT  &kp A   &kp S   &kp D           &kp F         &kp G                                        &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_GUI    &kp Z   &kp X   &kp C           &kp V         &kp B        &kp LBKT         &kp RBKT       &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp ESCAPE
                                &kp LEFT_SHIFT  &kp LEFT_ALT  &lt 1 ENTER  &mt LCTRL TAB    &kp BACKSPACE  &lt 2 SPACE  &kp RIGHT_ALT  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&kp ESC      &kp F1    &kp F2  &kp F3    &kp F4                &kp F5                                    &kp F6     &kp F7     &kp F8           &kp F9    &kp F10   &kp F11
&kp LA(TAB)  &kp F2    &kp F3  &kp F4    &kp LBKT              &kp RIGHT_BRACKET                         &kp F7     &kp F8     &kp F9           &kp F10   &kp F11   &kp F12
&kp GRAVE    &kp EXCL  &kp AT  &kp HASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                     &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&trans       &trans    &trans  &trans    &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans    &trans   &trans     &kp MINUS  &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                               &trans    &trans                &trans                 &trans    &kp DEL  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &trans         &trans           &trans           &trans     &trans    &bootloader
&kp LC(TAB)  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                          &kp PG_UP      &kp HOME         &kp UP_ARROW     &kp END    &kp N0    &trans
&kp F1       &kp F2        &kp F3        &kp F4        &kp F5        &kp F6                          &kp PAGE_DOWN  &kp LEFT         &kp DOWN         &kp RIGHT  &trans    &trans
&kp F7       &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &trans    &trans  &kp KP_PLUS    &macro_prev_tab  &macro_next_tab  &kp LBKT   &kp RBKT  &kp BSLH
                                         &trans        &trans        &trans        &trans    &trans  &trans         &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };
};
